from turtle import *

t = Turtle()
t.speed(500)
t.hideturtle()

class Flaggen_Bestandteile: #Klasse für die einzelnen Formen, die in den Flaggen erhalten sind. Baue ich eine Flagge suche ich mir hier die passenden Objekte aus.
    
    def draw_viereck(self, length, heigth, pencolor, fillcolor):
        self.length = length
        self.heigth = heigth
        self.pencolor = pencolor
        self.fillcolor = fillcolor
        t.pencolor(pencolor)
        t.fillcolor(fillcolor)
        t.begin_fill()
        for i in range(0, 4):
            if i % 2 == 0:
                t.forward(length)
                t.right(90)
            else:
                t.forward(heigth)
                t.right(90)
         
        t.end_fill()
        
    def draw_dreieck(self, length, pencolor, fillcolor):
        self.length = length
        self.pencolor = pencolor
        self.fillcolor = fillcolor
        t.pencolor(pencolor)
        t.fillcolor(fillcolor)
        t.begin_fill()
        for i in range(0, 3):
            t.forward(length)
            t.right(-120)
            
        t.end_fill()
        
        
    def draw_kreis(self, radius, pencolor, fillcolor):
        self.radius = radius
        self.pencolor = pencolor
        self.fillcolor = fillcolor
        t.pencolor(pencolor)
        t.fillcolor(fillcolor)
        t.begin_fill()
        t.circle(radius)
        t.end_fill()
        
    def draw_stern(self, length, pencolor, fillcolor):
        self.length = length
        self.pencolor = pencolor
        self.fillcolor = fillcolor
        t.pencolor(pencolor)
        t.fillcolor(fillcolor)
        t.begin_fill()
        t.forward(length)
        t.right(144)
        t.forward(length)
        t.right(144)
        t.forward(length)
        t.right(144)
        t.forward(length)
        t.right(144)
        t.forward(length)
        
        t.end_fill()
    
    

x = Flaggen_Bestandteile()

